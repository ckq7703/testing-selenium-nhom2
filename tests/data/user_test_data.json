{
  "add_user": [
    {
      "username": "",
      "password": "abc123",
      "role": "user",
      "expected": "error",
      "desc": "TC01_Thêm user - bỏ trống username"
    },
    {
      "username": "ab",
      "password": "abc123a",
      "role": "user",
      "expected": "error",
      "desc": "TC02_Thêm user - username quá ngắn"
    },
    {
      "username": "abc",
      "password": "abc123a",
      "role": "user",
      "expected": "success",
      "desc": "TC03_Thêm user - username 3 ký tự (hợp lệ)"
    },
    {
      "username": "abcdefghijklmnopqrst",
      "password": "abc123a",
      "role": "user",
      "expected": "success",
      "desc": "TC04_Thêm user - username 20 ký tự (hợp lệ)"
    },
    {
      "username": "abcdefghijklmnopqrstu",
      "password": "abc123a",
      "role": "user",
      "expected": "error",
      "desc": "TC05_Thêm user - username quá dài (21 ký tự)"
    },
    {
      "username": "user@123",
      "password": "abc123a",
      "role": "user",
      "expected": "error",
      "desc": "TC06_Thêm user - username chứa ký tự đặc biệt"
    },
    {
      "username": "admin",
      "password": "abc123a",
      "role": "user",
      "expected": "error",
      "desc": "TC07_Thêm user - username đã tồn tại"
    },
    {
      "username": "newuser",
      "password": "",
      "role": "user",
      "expected": "error",
      "desc": "TC08_Thêm user - bỏ trống password"
    },
    {
      "username": "newuser",
      "password": "12345",
      "role": "user",
      "expected": "error",
      "desc": "TC09_Thêm user - password quá ngắn"
    },
    {
      "username": "user123",
      "password": "Hu@t09",
      "role": "user",
      "expected": "success",
      "desc": "TC10_Thêm user - password 6 ký tự (hợp lệ)"
    },
    {
      "username": "userlong",
      "password": { "text": "a", "repeat": 257 },
      "role": "user",
      "expected": "error",
      "desc": "TC11_Thêm user - password quá dài (256 ký tự)"
    },
    {
      "username": "roleuser",
      "password": "abc123a",
      "role": "user",
      "expected": "success",
      "desc": "TC12_Thêm user - role = user (hợp lệ)"
    },
    {
      "username": "roleadmin",
      "password": "abc123a",
      "role": "admin",
      "expected": "success",
      "desc": "TC13_Thêm user - role = admin (hợp lệ)"
    }
  ]
}
